	// Each rule keeps only its first scope here; the rest name the same colour
	"tokenColors": [
		{ "scope": ["comment"], "settings": { "foreground": "#716C93" } },
		{ "scope": ["constant.character"], "settings": { "foreground": "#C5C2D6" } },
		{ "scope": ["keyword"], "settings": { "foreground": "#DF769B" } },
		{ "scope": ["variable"], "settings": { "foreground": "#E4B781" } },
		{ "scope": ["support.variable.property"], "settings": { "foreground": "#D67E5C" } },
		{ "scope": ["constant"], "settings": { "foreground": "#D5971A" } },
		{ "scope": ["variable.language"], "settings": { "foreground": "#E66533" } },
		{ "scope": ["string"], "settings": { "foreground": "#49E9A6" } },
		{ "scope": ["string.template"], "settings": { "foreground": "#16B673" } },
		{ "scope": ["constant.numeric"], "settings": { "foreground": "#7060EB" } },
		{ "scope": ["variable.function"], "settings": { "foreground": "#16A3B6" } },
		{ "scope": ["entity.name"], "settings": { "foreground": "#49D6E9" } },
		{ "scope": ["source.js constant.other.object.key.js string.unquoted.label.js"], "settings": { "foreground": "#49ACE9" } },
		{ "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E3541C" } },
		{ "scope": "token.info-token", "settings": { "foreground": "#6796E6" } },
		{ "scope": "token.warn-token", "settings": { "foreground": "#CD9731" } },
		{ "scope": "token.error-token", "settings": { "foreground": "#F44747" } },
		{ "scope": "token.debug-token", "settings": { "foreground": "#B267E6" } }
	]
}
