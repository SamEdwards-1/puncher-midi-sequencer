		"terminal.ansiBrightRed": "#f07178",
		"terminal.ansiBrightWhite": "#ffffff",
		"terminal.ansiBrightYellow": "#ffb454",
		"terminal.ansiCyan": "#93e2c8",
		"terminal.ansiGreen": "#70bf56",
		"terminal.ansiMagenta": "#d0a1ff",
		"terminal.ansiRed": "#f06b73",
		"terminal.ansiWhite": "#c7c7c7",
		"terminal.ansiYellow": "#fdb04c",
		"terminal.background": "#0d1017",
		"terminal.foreground": "#bfbdb6",
		"textLink.foreground": "#e6b450",
		"titleBar.activeBackground": "#0d1017",
		"titleBar.activeForeground": "#5a6378",
		"titleBar.border": "#1b1f29",
		"widget.border": "#1b1f29",
		"widget.shadow": "#00000080"
	},
	// The colours the utility reads, and each syntax rule's colour with its
	// first scope
	"tokenColors": [
		{ "scope": ["comment"], "settings": { "foreground": "#5A6673", "fontStyle": "italic" } },
		{ "scope": ["string"], "settings": { "foreground": "#AAD94C" } },
		{ "scope": ["string.regexp"], "settings": { "foreground": "#95E6CB" } },
		{ "scope": ["constant.numeric"], "settings": { "foreground": "#D2A6FF" } },
		{ "scope": ["variable"], "settings": { "foreground": "#BFBDB6" } },
		{ "scope": ["variable.member"], "settings": { "foreground": "#F07178" } },
		{ "scope": ["variable.language"], "settings": { "foreground": "#39BAE6" } },
		{ "scope": ["keyword"], "settings": { "foreground": "#FF8F40" } },
		{ "scope": ["keyword.operator"], "settings": { "foreground": "#F29668" } },
		{ "scope": ["source.java storage.type"], "settings": { "foreground": "#59C2FF" } },
		{ "scope": ["entity.name.function"], "settings": { "foreground": "#FFB454" } },
		{ "scope": ["meta.decorator variable.other"], "settings": { "foreground": "#E6C08A" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#D95757" } },
		{ "scope": ["meta.diff"], "settings": { "foreground": "#C594C5" } },
		{ "scope": ["markup.inserted"], "settings": { "foreground": "#70BF56" } },
		{ "scope": ["markup.changed"], "settings": { "foreground": "#73B8FF" } },
		{ "scope": ["markup.deleted"], "settings": { "foreground": "#F26D78" } },
		{ "scope": "token.info-token", "settings": { "foreground": "#6796E6" } },
		{ "scope": "token.warn-token", "settings": { "foreground": "#CD9731" } },
		{ "scope": "token.error-token", "settings": { "foreground": "#F44747" } },
		{ "scope": "token.debug-token", "settings": { "foreground": "#B267E6" } }
	]
}
