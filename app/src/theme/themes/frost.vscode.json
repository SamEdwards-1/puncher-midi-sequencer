	},
	// Each rule keeps only its colour and first scope here
	"tokenColors": [
		{ "scope": ["meta.paragraph.markdown"], "settings": { "foreground": "#110000" } },
		{ "scope": ["entity.name.section.markdown"], "settings": { "foreground": "#034C7C" } },
		{ "scope": ["punctuation.definition.string.begin.markdown"], "settings": { "foreground": "#00AC8F" } },
		{ "scope": ["markup.quote.markdown"], "settings": { "foreground": "#003494" } },
		{ "scope": ["markup.bold.markdown"], "settings": { "foreground": "#4E76B5" } },
		{ "scope": ["markup.italic.markdown"], "settings": { "foreground": "#C792EA" } },
		{ "scope": ["markup.inline.raw.string.markdown"], "settings": { "foreground": "#0460B1" } },
		{ "scope": ["markup.underline.link.image.markdown"], "settings": { "foreground": "#924205" } },
		{ "scope": "comment", "settings": { "foreground": "#357B42", "fontStyle": "italic" } },
		{ "scope": "punctuation.definition.string", "settings": { "foreground": "#D86DB6" } },
		{ "scope": "string", "settings": { "foreground": "#A44185" } },
		{ "scope": "constant.numeric", "settings": { "foreground": "#174781" } },
		{ "scope": ["constant.language"], "settings": { "foreground": "#2970C7" } },
		{ "scope": "variable", "settings": { "foreground": "#2F86D2" } },
		{ "scope": "variable.other.object.js", "settings": { "foreground": "#828282" } },
		{ "scope": "meta.class entity.name.type.class.tsx", "settings": { "foreground": "#7C2CBD" } },
		{ "scope": ["meta.method.declaration storage.type.ts"], "settings": { "foreground": "#4A668F" } },
		{ "scope": ["variable.other.object.property"], "settings": { "foreground": "#FA841D" } },
		{ "scope": ["variable.instance"], "settings": { "foreground": "#7FDBCA" } },
		{ "scope": "string.template meta.template.expression", "settings": { "foreground": "#C63ED3" } },
		{ "scope": "string.template punctuation.definition.string", "settings": { "foreground": "#3E3E3E" } },
		{ "scope": "storage", "settings": { "foreground": "#DA5221" } },
		{ "scope": ["keyword"], "settings": { "foreground": "#0991B6" } },
		{ "scope": ["keyword.operator"], "settings": { "foreground": "#7B30D0" } },
		{ "scope": ["storage", "meta.var.expr"], "settings": { "foreground": "#C792EA" } },
		{ "scope": ["variable.other.meta.import.js"], "settings": { "foreground": "#296D31" } },
		{ "scope": "entity.name.class", "settings": { "foreground": "#1172C7" } },
		{ "scope": "entity.other.inherited-class", "settings": { "foreground": "#B02767" } },
		{ "scope": "support.variable.property", "settings": { "foreground": "#358A7B" } },
		{ "scope": "entity.name.function", "settings": { "foreground": "#B1108E" } },
		{ "scope": "entity.name.tag", "settings": { "foreground": "#0444AC" } },
		{ "scope": "entity.other.attribute-name", "settings": { "foreground": "#DF8618" } },
		{ "scope": "support.function", "settings": { "foreground": "#08134A" } },
		{ "scope": ["support.type", "support.class"], "settings": { "foreground": "#DC3EB7" } },
		{ "scope": "support.other.variable", "settings": { "foreground": "#224555" } },
		{ "scope": "invalid", "settings": { "foreground": "#207BB8" } },
		{ "scope": "support.type.property-name.json", "settings": { "foreground": "#3A9685" } },
		{ "scope": "support.constant.json", "settings": { "foreground": "#497803" } },
		{ "scope": "meta.structure.dictionary.value.json string.quoted.double", "settings": { "foreground": "#8123A9" } },
		{ "scope": "string.quoted.double.json punctuation.definition.string.json", "settings": { "foreground": "#2B8C82" } },
		{ "scope": "meta.structure.dictionary.json meta.structure.dictionary.value constant.language", "settings": { "foreground": "#AE408B" } },
		{ "scope": "source.json support", "settings": { "foreground": "#6DBDFA" } },
		{ "scope": ["source.json string"], "settings": { "foreground": "#00820F" } },
		{ "scope": ["markup.heading punctuation.definition.heading"], "settings": { "foreground": "#4FB4D8" } },
		{ "scope": ["text.html.markdown meta.paragraph meta.link.inline"], "settings": { "foreground": "#87429A" } },
		{ "scope": "markup.deleted", "settings": { "foreground": "#B31D28" } },
		{ "scope": "markup.inserted", "settings": { "foreground": "#22863A" } },
		{ "scope": "source.dockerfile", "settings": { "foreground": "#005FA4" } },
		{ "scope": "token.info-token", "settings": { "foreground": "#316BCD" } },
		{ "scope": "token.warn-token", "settings": { "foreground": "#CD9731" } },
		{ "scope": "token.error-token", "settings": { "foreground": "#CD3131" } },
		{ "scope": "token.debug-token", "settings": { "foreground": "#800080" } }
	]
}
