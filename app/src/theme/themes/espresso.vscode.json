	// The workbench colours the theme sets that play a part here, and each
	// syntax rule's colour with its first scope
	"tokenColors": [
		{ "scope": ["support.module.elm"], "settings": { "foreground": "#FFA777" } },
		{ "scope": ["entity.name.type"], "settings": { "foreground": "#7E9E2D" } },
		{ "scope": ["comment"], "settings": { "foreground": "#564642", "fontStyle": "italic" } },
		{ "scope": ["constant"], "settings": { "foreground": "#F24343" } },
		{ "scope": ["source"], "settings": { "foreground": "#BEABA7" } },
		{ "scope": ["entity.name.function.decorator"], "settings": { "foreground": "#E480AD" } },
		{ "scope": ["keyword.control.export"], "settings": { "foreground": "#F7D979" } },
		{ "scope": ["support.function"], "settings": { "foreground": "#6EDDD6" } },
		{ "scope": ["meta.object-literal.key"], "settings": { "foreground": "#CEB5B0" } },
		{ "scope": ["punctuation"], "settings": { "foreground": "#CEB5B066" } },
		{ "scope": ["storage"], "settings": { "foreground": "#3CEAA8" } },
		{ "scope": ["string"], "settings": { "foreground": "#9DCC57" } },
		{ "scope": ["string.quoted.docstring.multi.python"], "settings": { "foreground": "#7A9437CC" } },
		{ "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#9991F1" } },
		{ "scope": ["variable"], "settings": { "foreground": "#F77A6A" } },
		{ "scope": ["meta.tag.sgml.doctype.html"], "settings": { "foreground": "#6EDDD6B3" } },
		{ "scope": ["constant.numeric"], "settings": { "foreground": "#FFA777" } },
		{ "scope": "token.info-token", "settings": { "foreground": "#6796E6" } },
		{ "scope": "token.warn-token", "settings": { "foreground": "#CD9731" } },
		{ "scope": "token.error-token", "settings": { "foreground": "#F44747" } },
		{ "scope": "token.debug-token", "settings": { "foreground": "#B267E6" } }
	]
}
