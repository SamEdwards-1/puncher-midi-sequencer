{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"],
      "env": ["NEXT_PUBLIC_APP_URL"]
    },
    "test": {
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "vitest.config.ts"]
    },
    "test:all": {
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "vitest.config.ts"]
    },
    "typecheck": {
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "tsconfig.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
